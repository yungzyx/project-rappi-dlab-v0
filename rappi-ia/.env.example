# Postgres (Homebrew local): la misma base que usa rappi-scraper
DATABASE_URL=postgresql:///rappi
# Base de tests propia, para no pisarse con los tests del scraper (rappi_test)
DATABASE_URL_TEST=postgresql:///rappi_ia_test

# Modelo local de texto (se descarga de Hugging Face la primera vez; si lo cambias, la primera vez `make serve HF_OFFLINE=`)
# TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Memoria de Postgres para construir los índices HNSW (solo durante esa transacción)
# HNSW_MAINTENANCE_WORK_MEM=1GB

# Opcional: con clave, Claude redacta las respuestas del agente; sin clave, plantillas.
# ANTHROPIC_API_KEY=
# AGENT_LLM_MODEL=claude-sonnet-5
# Nombre con que el agente se presenta (por defecto, Mochi)
# AGENT_NAME=Mochi

# Opcional: con clave de TypeSafe y un piloto aprobado (eval/jev-adopcion.json), el proceso semanal usa Jev (System One)
# para etiquetar categorías nuevas y como juez de la búsqueda; sin clave o sin adopción, no se llama a nadie (docs/jev.md).
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0
# Tope de llamadas por corrida (los reintentos cuentan) y cuántas van en paralelo
# JEV_MAX_REQUESTS=3000
# JEV_PARALLEL=16
# Precio en US$ por millón de tokens de entrada, para el costo que informa el piloto
# JEV_PRICE_PER_MTOK_INPUT=0.042

# API
# Orígenes permitidos para CORS, separados por coma. Reemplazan a los de por defecto (http://localhost:5174 y :5175):
# si sigues usando esos, inclúyelos también. Localhost y 127.0.0.1 en los puertos 51xx se aceptan siempre.
# API_CORS_ORIGINS=https://demo.ejemplo.cl,http://localhost:5174,http://localhost:5175
# API_ALLOW_LAN=1 lo pone `make serve-lan`: abre CORS a la red local (sin autenticación: solo en una red de confianza)
# Tope por consulta de la API en ms (504 si se pasa): pantallas de la app y panel (/analytics/*)
# API_TIMEOUT_INTERACTIVE_MS=5000
# API_TIMEOUT_ANALYTICS_MS=30000
# Punto fijo de la demo (Providencia, Santiago) desde el que /catalog/home mide «Cerca de ti»
# MVP_HOME_LAT=-33.4263
# MVP_HOME_LNG=-70.6106

# Productos mínimos que debe tener un concepto en la vertical para entrar en un desafío del juego (`make mvp-check` usa 1)
# GAME_MIN_ITEMS=20

# Arrancar la API y los comandos sin cargar modelos (tests, o un equipo sin el extra ml)
# RAPPI_IA_LIGHT=1

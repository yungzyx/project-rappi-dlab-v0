# Postgres (Homebrew local): la misma base que usa rappi-scraper
DATABASE_URL=postgresql:///rappi
# Base de tests propia, para no pisarse con los tests del scraper (rappi_test)
DATABASE_URL_TEST=postgresql:///rappi_ia_test

# Modelos locales (se descargan de Hugging Face la primera vez)
# TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
# IMAGE_TEXT_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
# WHISPER_MODEL=small
# Memoria de Postgres para construir los índices HNSW (solo durante esa transacción)
# HNSW_MAINTENANCE_WORK_MEM=1GB

# Opcional: con clave, Claude redacta las respuestas de Bigotes; sin clave, plantillas.
# ANTHROPIC_API_KEY=
# BIGOTES_LLM_MODEL=claude-sonnet-5

# API
# API_CORS_ORIGINS=http://localhost:5174,http://localhost:5175

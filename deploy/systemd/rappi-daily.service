# Trabajos diarios del servidor, en el contenedor jobs e independientes de la descarga semanal:
#   1. `rappi-ia purge`: borra el texto de las búsquedas de más de 90 días y a las personas del prototipo sin actividad
#      en 180.
#   2. deploy/scripts/backup-nightly.sh: respaldo de la base en el volumen (quedan 3) y copia fuera del equipo con
#      restic. Sin RESTIC_REPOSITORY sale con 2 y el servicio queda en rojo.
# La purga va primero: un respaldo que falla (o que todavía no tiene restic) no la frena. Si falla la purga, el
# respaldo de esa noche no corre y el servicio queda en rojo (`systemctl status rappi-daily`).
[Unit]
Description=Rappi: purga diaria y respaldo nocturno
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Editar: la carpeta del repo en el servidor (la misma en rappi-refresh.service).
WorkingDirectory=/opt/rappi
Environment=RAPPI_ENV_FILE=/etc/rappi/rappi.env
ExecStart=/usr/bin/docker compose --env-file ${RAPPI_ENV_FILE} -f deploy/docker-compose.yml --profile jobs run --rm jobs rappi-ia purge
ExecStart=/usr/bin/docker compose --env-file ${RAPPI_ENV_FILE} -f deploy/docker-compose.yml --profile jobs run --rm jobs bash deploy/scripts/backup-nightly.sh
# Volcar y subir la base toma minutos; uno colgado no debe quedar hasta el día siguiente.
TimeoutStartSec=6h

rappi-ia/data
**/*.dump
**/*.sql.gz
**/*.backup

# Variables de entorno y claves: solo los ejemplos
**/.env*
!**/.env.example

# Entornos y cachés locales
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/node_modules
**/dist
**/dist-desktop
**/.DS_Store

# Tests: no corren en la imagen
rappi-scraper/tests
rappi-ia/tests
